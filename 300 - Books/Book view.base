views:
  - type: cards
    name: Table
    filters:
      and:
        - file.folder.contains("obsidian-git-sync/300 - Books")
        - '!file.name.contains("chapter")'
        - '!file.name.contains("png")'
        - '!file.name.contains("base")'
    order:
      - file.name
      - authors
    image: note.cover
    imageFit: contain
    imageAspectRatio: 1.5
